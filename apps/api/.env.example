NODE_ENV=development
PORT=3000

# Local dev: `npm run dev` syncs this from Prisma Dev automatically.
# Prisma Dev (default): postgres://postgres:postgres@localhost:<port>/template1?sslmode=disable
# Docker alternative: postgresql://erp:erp@localhost:5432/erpqalam
DATABASE_URL=postgresql://erp:erp@localhost:5432/erpqalam

JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too-use-different-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Optional — enable when Redis is added
# REDIS_URL=redis://redis:6379
CACHE_STORE=memory
REFRESH_TOKEN_STORE=database

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3002/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3001
GOOGLE_OAUTH_DEFAULT_SCHOOL_CODE=QALAM001
GOOGLE_OAUTH_AUTO_ADMIN_EMAILS=hamaamohamad7@gmail.com
