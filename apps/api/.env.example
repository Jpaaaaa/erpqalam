NODE_ENV=development
PORT=3002

# Local dev: Docker Postgres when Docker Desktop is running (stable on hot reload).
# If Docker is unavailable, `npm run dev` falls back to Prisma Dev automatically.
DATABASE_URL=postgresql://erp:erp@localhost:5432/erpqalam

# Force Prisma Dev only (skip Docker):
# USE_PRISMA_DEV=1

JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too-use-different-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Optional — enable when Redis is added
# REDIS_URL=redis://redis:6379
CACHE_STORE=memory
REFRESH_TOKEN_STORE=database

# ZKTeco ADMS push (iclock) — devices POST to http://<host>:3002/iclock/cdata
# Auto-register unknown device serial numbers to the first school (testing only)
ICLOCK_AUTO_REGISTER=true
# Test handshake:
#   curl -i "http://localhost:3002/iclock/cdata?SN=TEST123&options=all&pushver=2.4.1"
# Test ATTLOG push:
#   curl -i -X POST "http://localhost:3002/iclock/cdata?SN=TEST123&table=ATTLOG" \
#     -H "Content-Type: text/plain" \
#     --data $'101\t2026-08-31 08:30:00\t0\t1\t0\t0'
#
# Import HRAT user names (one-time):
#   HRAT_DB_PATH=~/.config/hrat/attendance.db npm run import:hrat-users --prefix apps/api
# Or from CSV:
#   HRAT_USERS_CSV=./hrat-users.csv npm run import:hrat-users --prefix apps/api

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3002/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3001
GOOGLE_OAUTH_DEFAULT_SCHOOL_CODE=QALAM001
GOOGLE_OAUTH_AUTO_ADMIN_EMAILS=hamaamohamad7@gmail.com
