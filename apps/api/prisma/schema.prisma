generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MANAGER
  EMPLOYEE
}

enum UserPermission {
  USER_MANAGEMENT
  STUDENT_REGISTRATION
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

model School {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                      User[]
  students                   Student[]
  pendingStudents            PendingStudent[]
  documentRequestSettings    DocumentRequestSettings?
  documentRequestLetters     DocumentRequestLetter[]
}

/// Intake queue — staff or public check-in; approved rows move to Student.
model PendingStudent {
  id                String   @id @default(cuid())
  firstName         String
  secondName        String
  thirdName         String?
  fourthName        String?
  section           String?
  phoneNumbers      String[] @default([])
  guardianInfo      String?
  comeViaWho          String?
  homeAddress         String?
  birthPlace          String?
  birthDate           DateTime?
  nationalIdNumber    String?
  residenceCardNumber String?
  foodRationCardNumber String?
  guardianName        String?
  guardianMobile      String?
  stage               String?
  detailsCompletedAt  DateTime?
  schoolId          String
  school            School   @relation(fields: [schoolId], references: [id])
  submittedByUserId String?
  submittedBy       User?    @relation("PendingStudentSubmissions", fields: [submittedByUserId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  documentRequestLetters DocumentRequestLetter[]

  @@index([schoolId])
  @@index([submittedByUserId])
  @@index([schoolId, createdAt])
}

/// Enrolled students — created when a pending record is approved.
model Student {
  id                 String   @id @default(cuid())
  firstName          String
  secondName         String
  thirdName          String?
  fourthName         String?
  section            String
  phoneNumbers       String[] @default([])
  guardianInfo       String?
  comeViaWho         String?
  homeAddress        String?
  birthPlace         String?
  birthDate          DateTime?
  nationalIdNumber   String?
  residenceCardNumber String?
  foodRationCardNumber String?
  guardianName       String?
  guardianMobile     String?
  stage              String?
  detailsCompletedAt DateTime?
  schoolId           String
  school             School   @relation(fields: [schoolId], references: [id])
  registeredByUserId String?
  registeredBy       User?    @relation(fields: [registeredByUserId], references: [id])
  registeredAt       DateTime @default(now())
  pendingStudentId   String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  documentRequestLetters DocumentRequestLetter[]

  @@index([schoolId])
  @@index([registeredByUserId])
  @@index([schoolId, registeredAt])
}

model DocumentRequestSettings {
  id         String   @id @default(cuid())
  schoolId   String   @unique
  school     School   @relation(fields: [schoolId], references: [id])
  prefix     String   @default("ب")
  nextNumber Int      @default(1)
  updatedAt  DateTime @updatedAt
}

model DocumentRequestLetter {
  id                 String   @id @default(cuid())
  schoolId           String
  school             School   @relation(fields: [schoolId], references: [id])
  documentNumber     String
  documentDate       DateTime @db.Date
  studentFullName    String
  previousSchoolName String
  pendingStudentId   String?
  pendingStudent     PendingStudent? @relation(fields: [pendingStudentId], references: [id], onDelete: SetNull)
  studentId          String?
  student            Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  generatedByUserId  String
  generatedBy        User     @relation(fields: [generatedByUserId], references: [id])
  createdAt          DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([studentId])
  @@index([pendingStudentId])
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         UserRole
  permissions  UserPermission[] @default([])
  status       UserStatus       @default(PENDING)
  schoolId     String
  school       School           @relation(fields: [schoolId], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  refreshTokens           RefreshToken[]
  registeredStudents      Student[]
  pendingSubmissions      PendingStudent[] @relation("PendingStudentSubmissions")
  documentRequestLetters  DocumentRequestLetter[]

  @@index([schoolId])
  @@index([role])
  @@index([status])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
