generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MANAGER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

model School {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                      User[]
  students                   Student[]
  pendingStudents            PendingStudent[]
  documentRequestSettings    DocumentRequestSettings?
  documentRequestLetters     DocumentRequestLetter[]
  attendanceDevices          AttendanceDevice[]
  attendanceSettings         AttendanceSettings[]
  attendanceUsers            AttendanceUser[]
  attendanceRecords          AttendanceRecord[]
  attendanceHolidays         AttendanceHoliday[]
}

/// Intake queue — staff or public check-in; approved rows move to Student.
model PendingStudent {
  id                String   @id @default(cuid())
  firstName         String
  secondName        String
  thirdName         String?
  fourthName        String?
  section           String?
  phoneNumbers      String[] @default([])
  guardianInfo      String?
  comeViaWho          String?
  homeAddress         String?
  birthPlace          String?
  birthDate           DateTime?
  nationalIdNumber    String?
  residenceCardNumber String?
  foodRationCardNumber String?
  guardianName        String?
  guardianMobile      String?
  stage               String?
  detailsCompletedAt  DateTime?
  schoolId          String
  school            School   @relation(fields: [schoolId], references: [id])
  submittedByUserId String?
  submittedBy       User?    @relation("PendingStudentSubmissions", fields: [submittedByUserId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  documentRequestLetters DocumentRequestLetter[]

  @@index([schoolId])
  @@index([submittedByUserId])
  @@index([schoolId, createdAt])
}

/// Enrolled students — created when a pending record is approved.
model Student {
  id                 String   @id @default(cuid())
  firstName          String
  secondName         String
  thirdName          String?
  fourthName         String?
  section            String
  phoneNumbers       String[] @default([])
  guardianInfo       String?
  comeViaWho         String?
  homeAddress        String?
  birthPlace         String?
  birthDate          DateTime?
  nationalIdNumber   String?
  residenceCardNumber String?
  foodRationCardNumber String?
  guardianName       String?
  guardianMobile     String?
  stage              String?
  detailsCompletedAt DateTime?
  schoolId           String
  school             School   @relation(fields: [schoolId], references: [id])
  registeredByUserId String?
  registeredBy       User?    @relation(fields: [registeredByUserId], references: [id])
  registeredAt       DateTime @default(now())
  pendingStudentId   String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  documentRequestLetters DocumentRequestLetter[]

  @@index([schoolId])
  @@index([registeredByUserId])
  @@index([schoolId, registeredAt])
}

model DocumentRequestSettings {
  id                  String   @id @default(cuid())
  schoolId            String   @unique
  school              School   @relation(fields: [schoolId], references: [id])
  prefix              String   @default("ب")
  nextNumber          Int      @default(1)
  defaultAcademicYear String?
  bodyTemplate        String   @default("نظراً للقبول الطالب/ة {{studentName}} في معهدنا ({{instituteName}}) للعام الدراسي {{academicYear}} يرجى تزويدنا بالوثيقة لآخر المرحلة الدراسية .")
  letterheadTemplateFileName     String?
  letterheadTemplateUploadedAt   DateTime?
  updatedAt           DateTime @updatedAt
}

model BackupSettings {
  id         String   @id @default(cuid())
  botToken   String   @default("")
  chatIds    String[] @default([])
  backupTime String   @default("20:00")

  /// PDF activity reports via Telegram
  dailyReportEnabled   Boolean @default(true)
  dailyReportTime      String  @default("20:00")
  weeklyReportEnabled  Boolean @default(true)
  /// 0=Sunday … 6=Saturday (same as JS Date.getDay())
  weeklyReportDay      Int     @default(6)
  weeklyReportTime     String  @default("20:00")
  monthlyReportEnabled Boolean @default(true)
  /// Day of month to send previous month's report (1–28 recommended)
  monthlyReportDay     Int     @default(1)
  monthlyReportTime    String  @default("20:00")

  updatedAt DateTime @updatedAt
}

model DocumentRequestLetter {
  id                 String   @id @default(cuid())
  schoolId           String
  school             School   @relation(fields: [schoolId], references: [id])
  documentNumber     String
  documentDate       DateTime @db.Date
  academicYear       String?
  language           String   @default("ar")
  studentFullName    String
  previousSchoolName String
  pendingStudentId   String?
  pendingStudent     PendingStudent? @relation(fields: [pendingStudentId], references: [id], onDelete: SetNull)
  studentId          String?
  student            Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  generatedByUserId  String
  generatedBy        User     @relation(fields: [generatedByUserId], references: [id])
  createdAt          DateTime @default(now())

  @@unique([schoolId, documentNumber])
  @@index([schoolId, createdAt])
  @@index([studentId])
  @@index([pendingStudentId])
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         UserRole
  permissions  String[]         @default([])
  status       UserStatus       @default(PENDING)
  schoolId     String
  school       School           @relation(fields: [schoolId], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  refreshTokens           RefreshToken[]
  registeredStudents      Student[]
  pendingSubmissions      PendingStudent[] @relation("PendingStudentSubmissions")
  documentRequestLetters  DocumentRequestLetter[]

  @@index([schoolId])
  @@index([role])
  @@index([status])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Attendance (ported from HRAT) ───────────────────────────────────────────
//
// Punch timestamps use @db.Timestamp (TIMESTAMP WITHOUT TIME ZONE): the device's
// local wall-clock time as reported, never converted to UTC.

enum AttendanceHolidayType {
  EARLY_EXIT @map("early_exit")
  ENTRY_LATE @map("entry_late")
  DAY_OFF    @map("day_off")
}

enum TimeLeaveUsageType {
  LATE_ARRIVAL @map("late_arrival")
  EARLY_EXIT   @map("early_exit")
}

model AttendanceDevice {
  id           String    @id @default(cuid())
  schoolId     String    @map("school_id")
  serialNumber String    @unique @map("serial_number")
  name         String    @default("")
  lastSeenAt   DateTime? @map("last_seen_at") @db.Timestamp(3)
  isActive     Boolean   @default(true) @map("is_active")

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

model AttendanceUser {
  id           String @id @default(cuid())
  schoolId     String @map("school_id")
  deviceUserId String @map("device_user_id")
  name         String @default("")

  workingDays            String? @map("working_days")
  shiftStartTime         String? @map("shift_start_time")
  shiftEndTime           String? @map("shift_end_time")
  entryZoneStart         String? @map("entry_zone_start")
  entryZoneEnd           String? @map("entry_zone_end")
  exitZoneStart          String? @map("exit_zone_start")
  exitZoneEnd            String? @map("exit_zone_end")
  lateZoneStartTime      String? @map("late_zone_start_time")
  lateZoneEndTime        String? @map("late_zone_end_time")
  earlyLeftZoneStartTime String? @map("early_left_zone_start_time")
  earlyLeftZoneEndTime   String? @map("early_left_zone_end_time")

  linkedUserId String? @unique @map("linked_user_id")

  school           School                @relation(fields: [schoolId], references: [id])
  timeLeaveUsages  TimeLeaveUsage[]
  leaveBalance     EmployeeLeaveBalance?
  employeeHolidays EmployeeHoliday[]

  @@unique([schoolId, deviceUserId])
  @@index([schoolId])
}

model AttendanceRecord {
  id           String   @id @default(cuid())
  schoolId     String   @map("school_id")
  deviceUserId String   @map("device_user_id")
  timestamp    DateTime @db.Timestamp(3)
  verifyType   String   @map("verify_type")
  deviceSerial String   @map("device_serial")
  createdAt    DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, deviceUserId, timestamp, deviceSerial])
  @@index([schoolId, timestamp])
  @@index([schoolId, deviceUserId])
}

model AttendanceSettings {
  schoolId String @map("school_id")
  key      String
  value    String @default("")

  school School @relation(fields: [schoolId], references: [id])

  @@id([schoolId, key])
}

model AttendanceHoliday {
  id       String                @id @default(cuid())
  schoolId String                @map("school_id")
  date     DateTime              @db.Date
  type     AttendanceHolidayType

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, date, type])
  @@index([schoolId, date])
}

model TimeLeaveUsage {
  id           String             @id @default(cuid())
  schoolId     String             @map("school_id")
  deviceUserId String             @map("device_user_id")
  date         DateTime           @db.Date
  timestamp    DateTime           @db.Timestamp(3)
  type         TimeLeaveUsageType

  user AttendanceUser @relation(fields: [schoolId, deviceUserId], references: [schoolId, deviceUserId])

  @@unique([schoolId, deviceUserId, timestamp, type])
  @@index([schoolId, deviceUserId, date])
}

model EmployeeLeaveBalance {
  schoolId     String @map("school_id")
  deviceUserId String @map("device_user_id")
  balanceDays  Float  @default(0) @map("balance_days")

  user AttendanceUser @relation(fields: [schoolId, deviceUserId], references: [schoolId, deviceUserId])

  @@id([schoolId, deviceUserId])
}

model EmployeeHoliday {
  id           String   @id @default(cuid())
  schoolId     String   @map("school_id")
  deviceUserId String   @map("device_user_id")
  date         DateTime @db.Date

  user AttendanceUser @relation(fields: [schoolId, deviceUserId], references: [schoolId, deviceUserId])

  @@unique([schoolId, deviceUserId, date])
  @@index([schoolId, deviceUserId, date])
}
